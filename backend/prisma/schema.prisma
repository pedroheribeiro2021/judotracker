generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fundação multi-modalidade (preparação; hoje só o judô é semeado/usado —
// ver docs/multi-sport.md e backend/src/domain/sports/). `sportId` nas
// tabelas abaixo tem default fixo para o judô, então nada muda no
// comportamento atual até existir uma UI de seleção de esporte.
model Sport {
  id   String @id @default(uuid())
  name String
  slug String @unique

  teams            Team[]
  competitions     Competition[]
  trainingSessions TrainingSession[]
}

enum Role {
  ATHLETE
  COACH
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  role         Role     @default(ATHLETE)
  passwordHash String?
  firebaseUid  String?  @unique
  createdAt    DateTime @default(now())
  athlete      Athlete?
  coach        Coach?
}

model Athlete {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id])
  userId          String           @unique
  dob             DateTime?
  sex             String?
  heightCm        Float?
  defaultWeightKg Float?
  coach           Coach?           @relation(fields: [coachId], references: [id])
  coachId         String?
  weighIns        WeighIn[]
  bodyMeasurements BodyMeasurement[]
  entries         Entry[]
  promotions      Promotion[]
  attendances     Attendance[]
  injuries        Injury[]
  createdAt       DateTime         @default(now())

  Media Media[]

  Team Team[]
}

model Coach {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String   @unique
  teamId           String?
  athletes         Athlete[]
  createdAt        DateTime @default(now())
  trainingSessions TrainingSession[]

  Team Team[]
}

model Team {
  id       String   @id @default(uuid())
  name     String
  sport    Sport    @relation(fields: [sportId], references: [id])
  sportId  String   @default("a0000000-0000-4000-8000-000000000001")
  coaches  Coach[]
  athletes Athlete[]
}

model WeighIn {
  id         String   @id @default(uuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  weightKg   Float
  recordedAt DateTime @default(now())
  method     String?
  notes      String?
  createdAt  DateTime @default(now())
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  heightCm  Float?
  waistCm   Float?
  hipCm     Float?
  date      DateTime
  createdAt DateTime @default(now())
}

enum CompetitionLevel {
  REGIONAL
  ESTADUAL
  NACIONAL
  INTERNACIONAL
}

model Competition {
  id                   String            @id @default(uuid())
  name                 String
  date                 DateTime
  location             String?
  level                CompetitionLevel?
  federation           String?
  city                 String?
  state                String?
  registrationDeadline DateTime?
  notes                String?
  entries              Entry[]
  sport                Sport             @relation(fields: [sportId], references: [id])
  sportId              String            @default("a0000000-0000-4000-8000-000000000001")
}

enum Medal {
  GOLD
  SILVER
  BRONZE
  NONE
}

model Entry {
  id            String      @id @default(uuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String
  athlete       Athlete     @relation(fields: [athleteId], references: [id])
  athleteId     String
  weightClass   String?
  result        String?
  rank          Int?
  finalPosition Int?
  medal         Medal?
  matches       Match[]
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum ScoreType {
  IPPON
  WAZA_ARI
  WAZA_ARI_AWASETE_IPPON
  DECISION
  HANSOKU_MAKE
  FUSEN_GACHI
}

model Match {
  id              String      @id @default(uuid())
  entry           Entry       @relation(fields: [entryId], references: [id])
  entryId         String
  round           String
  opponentName    String
  opponentClub    String?
  result          MatchResult
  scoreType       ScoreType?
  technique       String?
  shidosFor       Int         @default(0)
  shidosAgainst   Int         @default(0)
  goldenScore     Boolean     @default(false)
  durationSeconds Int?
  notes           String?
  createdAt       DateTime    @default(now())
}

// Progressão oficial de faixas do judô brasileiro (CBJ, Regulamento para
// Exame e Outorga de Faixas e Graus, Conselho Nacional de Graus, 2018),
// da faixa branca à faixa vermelha 10º Dan. Inclui as faixas bicolores de
// transição do sistema infantil (ex.: Branca/Cinza, Cinza/Azul) — ver
// backend/src/domain/beltRanks.ts para rótulos e cores de exibição.
enum BeltRank {
  WHITE
  WHITE_GREY
  GREY
  GREY_BLUE
  BLUE
  BLUE_YELLOW
  YELLOW
  YELLOW_ORANGE
  ORANGE
  GREEN
  PURPLE
  BROWN
  BLACK_1DAN
  BLACK_2DAN
  BLACK_3DAN
  BLACK_4DAN
  BLACK_5DAN
  RED_WHITE_6DAN
  RED_WHITE_7DAN
  RED_WHITE_8DAN
  RED_9DAN
  RED_10DAN
}

model Promotion {
  id         String   @id @default(uuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  rank       BeltRank
  promotedAt DateTime
  promotedBy String?
  notes      String?
  createdAt  DateTime @default(now())
}

enum TrainingType {
  TECHNICAL
  RANDORI
  PHYSICAL
  KATA
  COMPETITION_PREP
}

model TrainingSession {
  id              String       @id @default(uuid())
  date            DateTime
  type            TrainingType
  durationMinutes Int
  coach           Coach?       @relation(fields: [coachId], references: [id])
  coachId         String?
  notes           String?
  attendances     Attendance[]
  createdAt       DateTime     @default(now())
  sport           Sport        @relation(fields: [sportId], references: [id])
  sportId         String       @default("a0000000-0000-4000-8000-000000000001")
}

model Attendance {
  id        String          @id @default(uuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id])
  sessionId String
  athlete   Athlete         @relation(fields: [athleteId], references: [id])
  athleteId String
  present   Boolean         @default(true)

  @@unique([sessionId, athleteId])
}

enum InjurySeverity {
  MINOR
  MODERATE
  SEVERE
}

model Injury {
  id             String         @id @default(uuid())
  athlete        Athlete        @relation(fields: [athleteId], references: [id])
  athleteId      String
  bodyPart       String
  description    String
  occurredAt     DateTime
  expectedReturn DateTime?
  resolvedAt     DateTime?
  severity       InjurySeverity
  notes          String?
  createdAt      DateTime       @default(now())
}

model Media {
  id        String   @id @default(uuid())
  athlete   Athlete? @relation(fields: [athleteId], references: [id])
  athleteId String?
  type      String
  key       String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  details   Json?
  createdAt DateTime @default(now())
}

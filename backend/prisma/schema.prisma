generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATHLETE
  COACH
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  role         Role     @default(ATHLETE)
  passwordHash String?
  createdAt    DateTime @default(now())
  athlete      Athlete?
  coach        Coach?
}

model Athlete {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id])
  userId          String           @unique
  dob             DateTime?
  sex             String?
  heightCm        Float?
  defaultWeightKg Float?
  coach           Coach?           @relation(fields: [coachId], references: [id])
  coachId         String?
  weighIns        WeighIn[]
  bodyMeasurements BodyMeasurement[]
  entries         Entry[]
  createdAt       DateTime         @default(now())

  Media Media[]

  Team Team[]
}

model Coach {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  teamId    String?
  athletes  Athlete[]
  createdAt DateTime @default(now())

  Team Team[]
}

model Team {
  id       String   @id @default(uuid())
  name     String
  coaches  Coach[]
  athletes Athlete[]
}

model WeighIn {
  id         String   @id @default(uuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  weightKg   Float
  recordedAt DateTime @default(now())
  method     String?
  notes      String?
  createdAt  DateTime @default(now())
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  heightCm  Float?
  waistCm   Float?
  hipCm     Float?
  date      DateTime
  createdAt DateTime @default(now())
}

model Competition {
  id      String  @id @default(uuid())
  name    String
  date    DateTime
  location String?
  entries Entry[]
}

model Entry {
  id            String      @id @default(uuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String
  athlete       Athlete     @relation(fields: [athleteId], references: [id])
  athleteId     String
  weightClass   String?
  result        String?
  rank          Int?
}

model Media {
  id        String   @id @default(uuid())
  athlete   Athlete? @relation(fields: [athleteId], references: [id])
  athleteId String?
  type      String
  key       String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  details   Json?
  createdAt DateTime @default(now())
}

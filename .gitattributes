# Normaliza fim de linha: evita que o OneDrive/Windows marque todos os
# arquivos como modificados (CRLF vs LF). O git passa a guardar sempre LF.
* text=auto eol=lf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Scripts que precisam de CRLF no Windows
*.bat text eol=crlf
*.cmd text eol=crlf
